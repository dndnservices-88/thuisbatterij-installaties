# Kopieer dit bestand naar .env.local voor lokaal werken, en zet dezelfde sleutels
# in Vercel onder Project Settings → Environment Variables.
# Zet NOOIT een echte token in .env.example of in Git.

# ── Publicatiepoort ───────────────────────────────────────────────────────────
# Zolang dit niet op "true" staat: bouwstatusbalk zichtbaar, onbevestigde claims
# gemarkeerd, en de pagina staat op noindex. Pas op "true" zetten NADAT het
# claimregister is afgetekend door Limsolar.
NEXT_PUBLIC_LIVE=false

# ── Leadopslag ────────────────────────────────────────────────────────────────
# VERPLICHT in productie. Zonder deze waarde weigert de API-route de lead, want
# het bestandssysteem van Vercel is tijdelijk en de lead zou stil verdwijnen.
# Mag een Make/Zapier-webhook zijn, een eigen endpoint of een database-proxy.
LEAD_WEBHOOK_URL=

# ── Uitkomstregistratie ───────────────────────────────────────────────────────
# /api/uitkomst hangt een resultaat aan een lead: niet bereikbaar, A/B/C,
# afspraak geboekt, nagekomen, sale of geen sale. Van daaruit gaat het via het
# klik-ID terug naar Google Ads, en dát is wat het algoritme laat leren welke
# zoekterm sales oplevert in plaats van formulieren.
#
# UITKOMST_TOKEN is verplicht. Zonder deze waarde weigert het endpoint volledig
# met een 503, en dat is expres: hier wordt commerciële waarheid geschreven. Wie
# ongevraagd een sale kan melden, stuurt het biedalgoritme én onze facturatie.
# Genereren met: openssl rand -base64 32
# Meesturen als header x-uitkomst-token.
UITKOMST_TOKEN=

# Waar de uitkomst heen gaat: het CRM, of een Make-scenario dat het CRM bijwerkt
# en de regel in de importsheet zet. Verplicht zodra NEXT_PUBLIC_LIVE op "true"
# staat — een uitkomst die alleen in een logregel belandt is over negentig dagen
# niet meer aan een klik te koppelen, en terugwerkende kracht bestaat hier niet.
UITKOMST_WEBHOOK_URL=

# ── Mail (Resend) ─────────────────────────────────────────────────────────────
# Twee mails per lead: een bevestiging aan de klant en een melding aan de
# adviseur. Beide mogen mislukken zonder dat de lead verloren gaat — dan staat
# er een waarschuwing in de Runtime Logs en ligt de lead nog steeds vast.
#
# MAIL_VAN moet een adres zijn op een domein dat in Resend is geverifieerd met
# SPF- en DKIM-records. Zonder die verificatie weigert Resend, of belandt alles
# in de spammap. Formaat: Naam <adres@domein.nl>
RESEND_API_KEY=
MAIL_VAN=

# Waar de meldingsmail heen gaat. Meerdere adressen mogen, gescheiden door een
# komma. Dit is het adres dat je op je telefoon leest, niet je archiefadres.
MELDING_AAN=

# Optioneel: korte pushmelding bij elke lead. Elke dienst die een POST met JSON
# accepteert werkt — een tweede Make-webhook, ntfy, Pushover, Slack, een
# Telegram-bot. WhatsApp en sms lopen bewust via Make en niet via een eigen
# koppeling hier: die modules zitten er al in en een tweede leverancier erbij
# halen levert niets op behalve onderhoud.
PUSH_WEBHOOK_URL=

# ── Tag Manager ───────────────────────────────────────────────────────────────
# De enige meetvariabele die de browser nog nodig heeft. Zonder deze waarde komt
# er geen containersnippet in de pagina en meet de site niets. Dat is de
# bedoeling zolang de container niet bestaat: een halve meetopstelling is erger
# dan geen, want dan denk je dat je cijfers hebt.
#
# Container aanmaken onder JOUW Google-account, niet onder dat van Limsolar.
# Formaat: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# ── Meta ──────────────────────────────────────────────────────────────────────
# Dataset (pixel) aanmaken in JOUW Business Manager, niet in die van Limsolar.
# Wie de dataset aanmaakt, is eigenaar van de gebeurtenishistorie.
#
# Deze twee zijn serverzijdig, voor de Conversions API. De browserpixel zit nu in
# Tag Manager en heeft hier dus niets meer staan: NEXT_PUBLIC_META_PIXEL_ID is
# per 26 augustus 2026 vervallen. Staat hij nog in je .env.local of in Vercel,
# haal hem dan weg — hij doet niets meer en wekt de indruk van wel.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Alleen invullen tijdens het testen met Test Events. Daarna leeghalen, anders
# komen echte conversies in de testomgeving terecht.
META_TEST_EVENT_CODE=

# ── Google Ads ────────────────────────────────────────────────────────────────
# Hier staat niets meer. Het conversie-ID en het label horen bij de tag in Tag
# Manager en niet in de code: dan pas je ze aan zonder opnieuw uit te rollen.
# NEXT_PUBLIC_GOOGLE_ADS_ID en NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL zijn per
# 26 augustus 2026 vervallen.
#
# Wat wél blijft gelden: maak de conversieactie aan op MCC-niveau en niet in het
# klantaccount, dan blijft de conversiehistorie bij jou als het account verhuist.
#
# De site pusht bij een lead één gebeurtenis naar de dataLayer, met event_id en
# transaction_id — hetzelfde nummer onder twee namen. Hang de Ads-conversietag
# daaronder en zet transaction_id in het veld Transactie-ID, anders telt een
# herladen bedankscherm dubbel.
